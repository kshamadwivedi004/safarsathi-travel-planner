# SafarSathi Environment Variables Configuration
# Copy this file to `.env` and fill in your actual values

# GROQ API Key (Required)
# Get your free key from: https://console.groq.com/keys
# The key should start with 'gsk_'
GROQ_API_KEY=your_groq_api_key_here

# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Visit https://console.groq.com/keys
# 3. Sign up (free) and generate an API key
# 4. Replace 'your_groq_api_key_here' with your actual key
# 5. Save the file
# 6. Restart the application

# For detailed setup guide, see: API_KEY_SETUP.md
